+    n = insights.executar(conn)
+    conn.commit()
+    assert len(chamadas) == n
+    with conn.cursor() as cur:
+        cur.execute("SELECT texto_gerado FROM insight WHERE tela='VISAO_GERAL' LIMIT 1")
+        assert "o desmatamento em 2023" in cur.fetchone()[0]
